      "id": "36598243-3b85-4e2c-ae36-7908a5940180",
      "name": "Listing",
      "description": {
        "content": "Create and manipulate listings of items for sale.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "db1ccbd1-a7fd-4b54-bd64-7f80697d590a",
          "name": "Search for listings",
          "request": {
            "name": "Search for listings",
            "description": {
              "content": "Search for listings. Response is paginated and ordered. Default filter selects listings with status onsale or sold and not expired. Filter type `term` selects any listing whose property equals any provided value; `tags` additionally supports logical AND via the `^` operator.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "listing"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "term",
                  "value": "<string>",
                  "description": "Fuzzy search over name and description; generates relevance score."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "platform",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "genre",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "upc",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "shipping_paid_by",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "digital",
                  "value": "<boolean>"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "owner",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "condition",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "price",
                  "value": "<string>",
                  "description": "Range filter on integer price (cents)."
                },
                {
                  "disabled": false,
                  "key": "created",
                  "value": "<string>",
                  "description": "Date range filter."
                },
                {
                  "disabled": false,
                  "key": "updated",
                  "value": "<string>",
                  "description": "Date range filter."
                },
                {
                  "disabled": false,
                  "key": "expiration",
                  "value": "<string>",
                  "description": "Date range filter."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Term filter supporting OR (comma) and AND (^)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Array of fieldname:direction (asc|desc). Default _score:desc,created:desc."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
